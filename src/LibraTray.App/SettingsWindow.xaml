<Window x:Class="LibraTray.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Text.SettingsTitle}"
        Icon="/Assets/libratray.ico"
        Width="470"
        Height="650"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource Text.Settings}"
                       FontSize="22"
                       FontWeight="SemiBold" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Text.Device}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,12,0,4"
                                   Text="{DynamicResource Text.CustomName}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox x:Name="AliasTextBox"
                                 MaxLength="128"
                                 Padding="8,6"
                                 ToolTip="{DynamicResource Text.CustomNameTip}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Text.Appearance}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Text.Theme}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="ThemeComboBox"
                                          Margin="0,4,0,0"
                                          Padding="6,4" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Text.Language}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="LanguageComboBox"
                                          Margin="0,4,0,0"
                                          Padding="6,4" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,8,0,0"
                                   Text="{DynamicResource Text.AppearanceSaveHint}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <CheckBox x:Name="ShowOsdCheckBox"
                                  Margin="0,10,0,0"
                                  Content="{DynamicResource Text.ShowOsd}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Text.WindowsAutomation}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <CheckBox x:Name="LockAutomationCheckBox"
                                   Content="{DynamicResource Text.AutomationLock}" />
                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Margin="0,8,0,0"
                                  Content="{DynamicResource Text.StartWithWindows}" />
                        <CheckBox x:Name="ShutdownAutomationCheckBox"
                                  Margin="0,8,0,0"
                                  Content="{DynamicResource Text.AutomationShutdown}" />
                        <CheckBox x:Name="DisplayAutomationCheckBox"
                                  Margin="0,8,0,0"
                                  Content="{DynamicResource Text.AutomationDisplay}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Text.AdjustmentSteps}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Text.BrightnessRange}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox x:Name="BrightnessStepTextBox"
                                         Margin="0,4,0,0"
                                         Padding="8,6" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Text.TemperatureRange}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox x:Name="TemperatureStepTextBox"
                                         Margin="0,4,0,0"
                                         Padding="8,6" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="TrayWheelCheckBox"
                                  Margin="0,12,0,0"
                                  Content="{DynamicResource Text.TrayWheel}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Text.GlobalHotkeys}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,10"
                                   Text="{DynamicResource Text.HotkeyHint}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="148" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Text.ToggleMain}" />
                            <TextBox x:Name="MainPowerHotkeyTextBox"
                                     Grid.Column="1" Padding="8,5"
                                     IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyTextBox_GotKeyboardFocus" />
                            <TextBlock Grid.Row="1" Margin="0,9,0,0"
                                       VerticalAlignment="Center" Text="{DynamicResource Text.ToggleAmbient}" />
                            <TextBox x:Name="BackgroundPowerHotkeyTextBox"
                                     Grid.Row="1" Grid.Column="1"
                                     Margin="0,8,0,0" Padding="8,5"
                                     IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyTextBox_GotKeyboardFocus" />
                            <TextBlock Grid.Row="2" Margin="0,9,0,0"
                                       VerticalAlignment="Center" Text="{DynamicResource Text.BrightnessUp}" />
                            <TextBox x:Name="BrightnessUpHotkeyTextBox"
                                     Grid.Row="2" Grid.Column="1"
                                     Margin="0,8,0,0" Padding="8,5"
                                     IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyTextBox_GotKeyboardFocus" />
                            <TextBlock Grid.Row="3" Margin="0,9,0,0"
                                       VerticalAlignment="Center" Text="{DynamicResource Text.BrightnessDown}" />
                            <TextBox x:Name="BrightnessDownHotkeyTextBox"
                                     Grid.Row="3" Grid.Column="1"
                                     Margin="0,8,0,0" Padding="8,5"
                                     IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyTextBox_GotKeyboardFocus" />
                            <TextBlock Grid.Row="4" Margin="0,9,0,0"
                                       VerticalAlignment="Center" Text="{DynamicResource Text.TemperatureUp}" />
                            <TextBox x:Name="TemperatureUpHotkeyTextBox"
                                     Grid.Row="4" Grid.Column="1"
                                     Margin="0,8,0,0" Padding="8,5"
                                     IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyTextBox_GotKeyboardFocus" />
                            <TextBlock Grid.Row="5" Margin="0,9,0,0"
                                       VerticalAlignment="Center" Text="{DynamicResource Text.TemperatureDown}" />
                            <TextBox x:Name="TemperatureDownHotkeyTextBox"
                                     Grid.Row="5" Grid.Column="1"
                                     Margin="0,8,0,0" Padding="8,5"
                                     IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyTextBox_GotKeyboardFocus" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ValidationTextBlock"
                           Margin="2,12,2,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ErrorBrush}"
                           Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource Text.ImportSettings}"
                        Style="{StaticResource QuietButtonStyle}"
                        Click="ImportButton_Click" />
                <Button Margin="8,0,0,0"
                        Content="{DynamicResource Text.ExportSettings}"
                        Style="{StaticResource QuietButtonStyle}"
                        Click="ExportButton_Click" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="82"
                        Margin="0,0,8,0"
                        Content="{DynamicResource Text.Cancel}"
                        IsCancel="True"
                        Style="{StaticResource QuietButtonStyle}" />
                <Button Width="82"
                        Content="{DynamicResource Text.Save}"
                        IsDefault="True"
                        Style="{StaticResource QuietButtonStyle}"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
