<Window x:Class="LibraTray.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LibraTray 设置"
        Width="470"
        Height="650"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="设置"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0"
                       Text="配置仅保存在当前 Windows 用户目录中"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="设备"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,12,0,4"
                                   Text="自定义名称"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox x:Name="AliasTextBox"
                                 MaxLength="128"
                                 Padding="8,6"
                                 ToolTip="留空时恢复 Yeelight Libra Pro" />
                        <TextBlock Margin="0,7,0,0"
                                   Text="产品：Yeelight Libra Pro · 型号：YLTD003 · 内部型号：lamp15"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Windows 自动化"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,10"
                                   Text="默认全部关闭；跨启动恢复仅在关灯得到确认后执行"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <CheckBox x:Name="LockAutomationCheckBox"
                                  Content="锁定时关闭灯光，解锁后恢复" />
                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Margin="0,8,0,0"
                                  Content="登录 Windows 时自动启动 LibraTray" />
                        <CheckBox x:Name="ShutdownAutomationCheckBox"
                                  Margin="0,8,0,0"
                                  Content="关机或注销时关闭灯光，下次启动后条件恢复" />
                        <CheckBox x:Name="DisplayAutomationCheckBox"
                                  Margin="0,8,0,0"
                                  Content="显示器关闭时关闭灯光，开启后恢复" />
                        <TextBlock Margin="0,9,0,0"
                                   Text="设备不匹配、状态已改变或近期手动操作时不会覆盖"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="调节步进"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="亮度（1–25）"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox x:Name="BrightnessStepTextBox"
                                         Margin="0,4,0,0"
                                         Padding="8,6" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="色温（50–1000 K）"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox x:Name="TemperatureStepTextBox"
                                         Margin="0,4,0,0"
                                         Padding="8,6" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="TrayWheelCheckBox"
                                  Margin="0,12,0,0"
                                  Content="在托盘图标上滚动滚轮时调节主灯亮度" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="全局快捷键"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,10"
                                   Text="点击输入框，然后直接按下包含 Ctrl、Alt、Shift 或 Win 的组合键"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="148" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="切换主灯" />
                            <TextBox x:Name="MainPowerHotkeyTextBox"
                                     Grid.Column="1" Padding="8,5"
                                     IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyTextBox_GotKeyboardFocus" />
                            <TextBlock Grid.Row="1" Margin="0,9,0,0"
                                       VerticalAlignment="Center" Text="切换氛围灯" />
                            <TextBox x:Name="BackgroundPowerHotkeyTextBox"
                                     Grid.Row="1" Grid.Column="1"
                                     Margin="0,8,0,0" Padding="8,5"
                                     IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyTextBox_GotKeyboardFocus" />
                            <TextBlock Grid.Row="2" Margin="0,9,0,0"
                                       VerticalAlignment="Center" Text="主灯亮度增加" />
                            <TextBox x:Name="BrightnessUpHotkeyTextBox"
                                     Grid.Row="2" Grid.Column="1"
                                     Margin="0,8,0,0" Padding="8,5"
                                     IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyTextBox_GotKeyboardFocus" />
                            <TextBlock Grid.Row="3" Margin="0,9,0,0"
                                       VerticalAlignment="Center" Text="主灯亮度降低" />
                            <TextBox x:Name="BrightnessDownHotkeyTextBox"
                                     Grid.Row="3" Grid.Column="1"
                                     Margin="0,8,0,0" Padding="8,5"
                                     IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyTextBox_GotKeyboardFocus" />
                            <TextBlock Grid.Row="4" Margin="0,9,0,0"
                                       VerticalAlignment="Center" Text="提高色温" />
                            <TextBox x:Name="TemperatureUpHotkeyTextBox"
                                     Grid.Row="4" Grid.Column="1"
                                     Margin="0,8,0,0" Padding="8,5"
                                     IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyTextBox_GotKeyboardFocus" />
                            <TextBlock Grid.Row="5" Margin="0,9,0,0"
                                       VerticalAlignment="Center" Text="降低色温" />
                            <TextBox x:Name="TemperatureDownHotkeyTextBox"
                                     Grid.Row="5" Grid.Column="1"
                                     Margin="0,8,0,0" Padding="8,5"
                                     IsReadOnly="True"
                                     PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyTextBox_GotKeyboardFocus" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ValidationTextBlock"
                           Margin="2,12,2,0"
                           TextWrapping="Wrap"
                           Foreground="#FFB5473C"
                           Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="82"
                    Margin="0,0,8,0"
                    Content="取消"
                    IsCancel="True"
                    Style="{StaticResource QuietButtonStyle}" />
            <Button Width="82"
                    Content="保存"
                    IsDefault="True"
                    Style="{StaticResource QuietButtonStyle}"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
