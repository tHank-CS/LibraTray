<Window x:Class="LibraTray.App.QuickPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LibraTray"
        Width="408"
        Height="670"
        MinWidth="368"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource WindowBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding DeviceName}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Margin="0,1,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FF9AA3AA" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeviceOnline}"
                                                     Value="True">
                                            <Setter Property="Fill"
                                                    Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Button Margin="12,-6,0,-6"
                                Padding="9,4"
                                IsEnabled="{Binding CanRetry}"
                                Content="重试"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="RetryButton_Click" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#FFB5473C">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Style="{StaticResource QuietButtonStyle}"
                        ToolTip="隐藏快速控制"
                        Click="HideButton_Click">
                    <TextBlock Text="×" FontSize="20" Margin="0,-2,0,0" />
                </Button>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource SectionCardStyle}"
                    IsEnabled="{Binding CanControl}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="主灯"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="亮度与色温"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Content="开启"
                                  IsChecked="{Binding MainPower, Mode=OneWay}"
                                  Click="MainPower_Click" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="亮度"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Slider Grid.Column="1"
                                Minimum="1"
                                Maximum="100"
                                Value="{Binding MainBrightness, Mode=OneWay}"
                                PreviewMouseLeftButtonUp="MainBrightness_PointerReleased" />
                        <TextBlock Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="{Binding MainBrightness}" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="色温"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Slider Grid.Column="1"
                                Minimum="3000"
                                Maximum="6500"
                                TickFrequency="100"
                                IsSnapToTickEnabled="True"
                                Value="{Binding MainColorTemperature, Mode=OneWay}"
                                PreviewMouseLeftButtonUp="MainColorTemperature_PointerReleased" />
                        <TextBlock Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="{Binding MainColorTemperature,
                                                  StringFormat={}{0} K}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="4"
                    Style="{StaticResource SectionCardStyle}"
                    IsEnabled="{Binding CanControl}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="氛围灯"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="独立亮度与颜色"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Content="开启"
                                  IsChecked="{Binding BackgroundPower, Mode=OneWay}"
                                  Click="BackgroundPower_Click" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="亮度"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Slider Grid.Column="1"
                                Minimum="1"
                                Maximum="100"
                                Value="{Binding BackgroundBrightness, Mode=OneWay}"
                                PreviewMouseLeftButtonUp="BackgroundBrightness_PointerReleased" />
                        <TextBlock Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="{Binding BackgroundBrightness}" />
                    </Grid>
                    <StackPanel Margin="0,15,0,0" Orientation="Horizontal">
                        <TextBlock Width="52"
                                   VerticalAlignment="Center"
                                   Text="颜色"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Button Width="30"
                                Height="30"
                                Margin="0,0,8,0"
                                Padding="2"
                                Tag="16753920"
                                ToolTip="橙色"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="BackgroundColor_Click">
                            <Ellipse Width="20"
                                     Height="20"
                                     Fill="#FFFFA500" />
                        </Button>
                        <Button Width="30"
                                Height="30"
                                Margin="0,0,8,0"
                                Padding="2"
                                Tag="65280"
                                ToolTip="绿色"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="BackgroundColor_Click">
                            <Ellipse Width="20"
                                     Height="20"
                                     Fill="#FF00C96B" />
                        </Button>
                        <Button Width="30"
                                Height="30"
                                Margin="0,0,8,0"
                                Padding="2"
                                Tag="255"
                                ToolTip="蓝色"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="BackgroundColor_Click">
                            <Ellipse Width="20"
                                     Height="20"
                                     Fill="#FF438DFF" />
                        </Button>
                        <Button Width="30"
                                Height="30"
                                Margin="0,0,8,0"
                                Padding="2"
                                Tag="8388736"
                                ToolTip="紫色"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="BackgroundColor_Click">
                            <Ellipse Width="20"
                                     Height="20"
                                     Fill="#FF9B66D9" />
                        </Button>
                        <Button Height="30"
                                Padding="8,2"
                                Content="自定义"
                                ToolTip="输入 RGB 十六进制颜色"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="CustomBackgroundColor_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="6"
                    Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="本地预设"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <Grid Margin="0,11,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox MinHeight="30"
                                  Padding="7,4"
                                  ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding SelectedPreset}"
                                  DisplayMemberPath="Name" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Content="应用"
                                IsEnabled="{Binding CanControl}"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="ApplyPresetButton_Click" />
                        <Button Grid.Column="2"
                                Margin="6,0,0,0"
                                Content="保存"
                                IsEnabled="{Binding IsDeviceOnline}"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="SavePresetButton_Click" />
                        <Button Grid.Column="3"
                                Margin="6,0,0,0"
                                Content="删除"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="DeletePresetButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="8"
                    Padding="13,11"
                    Background="{StaticResource AccentSoftBrush}"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="●"
                               FontSize="10"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Top"
                               Margin="0,2,10,0" />
                    <TextBlock Grid.Column="1"
                               Text="只连接精确识别为 lamp15 的本地设备；每次写入都会复读确认。"
                               TextWrapping="Wrap"
                               FontSize="12"
                               LineHeight="18"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>
            </Border>

            <Grid Grid.Row="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="纯局域网 · 无需账号"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Margin="0,4,12,0"
                               MaxWidth="280"
                               Text="{Binding HotkeyStatus}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="#FFB06B20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HotkeyStatus}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="设置"
                        Style="{StaticResource QuietButtonStyle}"
                        ToolTip="打开本地设置"
                        Click="SettingsButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
