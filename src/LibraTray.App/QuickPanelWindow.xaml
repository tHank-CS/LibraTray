<Window x:Class="LibraTray.App.QuickPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LibraTray"
        Width="408"
        SizeToContent="Height"
        MinWidth="368"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource WindowBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding DeviceName}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Margin="0,1,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FF9AA3AA" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeviceOnline}"
                                                     Value="True">
                                            <Setter Property="Fill"
                                                    Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Margin="12,-6,0,-6"
                                Padding="9,4"
                                IsEnabled="{Binding CanRetry}"
                                Content="{DynamicResource Text.Retry}"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="RetryButton_Click" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource ErrorBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Style="{StaticResource QuietButtonStyle}"
                        ToolTip="{DynamicResource Text.HideQuickPanel}"
                        Click="HideButton_Click">
                    <TextBlock Text="×" FontSize="20" Margin="0,-2,0,0" />
                </Button>
            </Grid>

            <Border Grid.Row="2"
                    Style="{StaticResource SectionCardStyle}"
                    IsEnabled="{Binding CanControl}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Text.MainLight}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Text.MainLightSubtitle}"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="{DynamicResource Text.MainPowerSwitch}"
                                      IsChecked="{Binding MainPower, Mode=OneWay}"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Click="MainPower_Click" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{DynamicResource Text.Brightness}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Slider Grid.Column="1"
                                Minimum="1"
                                Maximum="100"
                                Ticks="{Binding MainBrightnessTicks}"
                                SmallChange="{Binding MainBrightnessStep}"
                                LargeChange="{Binding MainBrightnessStep}"
                                IsSnapToTickEnabled="True"
                                Value="{Binding MainBrightness, Mode=OneWay}"
                                PreviewKeyUp="MainBrightness_KeyReleased"
                                PreviewMouseLeftButtonUp="MainBrightness_PointerReleased" />
                        <TextBlock Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="{Binding MainBrightness}" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{DynamicResource Text.ColorTemperature}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Slider Grid.Column="1"
                                Minimum="{Binding MainColorTemperatureMinimum}"
                                Maximum="{Binding MainColorTemperatureMaximum}"
                                Ticks="{Binding MainColorTemperatureTicks}"
                                SmallChange="{Binding MainColorTemperatureStep}"
                                LargeChange="{Binding MainColorTemperatureStep}"
                                IsSnapToTickEnabled="True"
                                Value="{Binding MainColorTemperature, Mode=OneWay}"
                                PreviewKeyUp="MainColorTemperature_KeyReleased"
                                PreviewMouseLeftButtonUp="MainColorTemperature_PointerReleased" />
                        <TextBlock Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="{Binding MainColorTemperature,
                                                  StringFormat={}{0} K}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="4"
                    Style="{StaticResource SectionCardStyle}"
                    IsEnabled="{Binding CanControl}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Text.AmbientLight}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Text.AmbientSubtitle}"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="{DynamicResource Text.AmbientPowerSwitch}"
                                      IsChecked="{Binding BackgroundPower, Mode=OneWay}"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Click="BackgroundPower_Click" />
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{DynamicResource Text.Brightness}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Slider Grid.Column="1"
                                Minimum="1"
                                Maximum="100"
                                Ticks="{Binding BackgroundBrightnessTicks}"
                                SmallChange="{Binding BackgroundBrightnessStep}"
                                LargeChange="{Binding BackgroundBrightnessStep}"
                                IsSnapToTickEnabled="True"
                                Value="{Binding BackgroundBrightness, Mode=OneWay}"
                                PreviewKeyUp="BackgroundBrightness_KeyReleased"
                                PreviewMouseLeftButtonUp="BackgroundBrightness_PointerReleased" />
                        <TextBlock Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="{Binding BackgroundBrightness}" />
                    </Grid>
                    <StackPanel Margin="0,13,0,0"
                                Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExperimentalSegmentRgbEnabled}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <RadioButton Margin="52,0,14,0"
                                     Content="{DynamicResource Text.WholeColor}"
                                     IsChecked="{Binding IsWholeColorMode, Mode=OneWay}"
                                     Checked="WholeColorMode_Checked" />
                        <RadioButton Content="{DynamicResource Text.SegmentColor}"
                                     IsChecked="{Binding IsSegmentColorMode, Mode=OneWay}"
                                     Checked="SegmentColorMode_Checked" />
                    </StackPanel>
                    <StackPanel Margin="0,15,0,0" Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSegmentColorMode}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Width="52"
                                   VerticalAlignment="Center"
                                   Text="{DynamicResource Text.Color}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Width="30"
                                Height="30"
                                Margin="0,0,8,0"
                                Padding="2"
                                Tag="16753920"
                                ToolTip="{DynamicResource Text.Orange}"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="BackgroundColor_Click">
                            <Border Width="20"
                                    Height="20"
                                    CornerRadius="5"
                                    Background="#FFFFA500" />
                        </Button>
                        <Button Width="30"
                                Height="30"
                                Margin="0,0,8,0"
                                Padding="2"
                                Tag="65280"
                                ToolTip="{DynamicResource Text.Green}"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="BackgroundColor_Click">
                            <Border Width="20"
                                    Height="20"
                                    CornerRadius="5"
                                    Background="#FF00C96B" />
                        </Button>
                        <Button Width="30"
                                Height="30"
                                Margin="0,0,8,0"
                                Padding="2"
                                Tag="255"
                                ToolTip="{DynamicResource Text.Blue}"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="BackgroundColor_Click">
                            <Border Width="20"
                                    Height="20"
                                    CornerRadius="5"
                                    Background="#FF438DFF" />
                        </Button>
                        <Button Width="30"
                                Height="30"
                                Margin="0,0,8,0"
                                Padding="2"
                                Tag="8388736"
                                ToolTip="{DynamicResource Text.Purple}"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="BackgroundColor_Click">
                            <Border Width="20"
                                    Height="20"
                                    CornerRadius="5"
                                    Background="#FF9B66D9" />
                        </Button>
                        <Button Height="30"
                                Padding="8,2"
                                Content="{DynamicResource Text.Custom}"
                                ToolTip="{DynamicResource Text.CustomColorTip}"
                                Style="{StaticResource QuietButtonStyle}"
                                 Click="CustomBackgroundColor_Click" />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSegmentColorMode}"
                                                 Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{DynamicResource Text.Color}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Grid.Column="1"
                                    Height="34"
                                    Padding="5,3"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Click="LeftSegmentColor_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="24" Height="20"
                                            CornerRadius="5"
                                            Background="{Binding LeftSegmentBrush}" />
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{DynamicResource Text.LeftZone}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3"
                                    Height="34"
                                    Padding="5,3"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Click="RightSegmentColor_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="24" Height="20"
                                            CornerRadius="5"
                                            Background="{Binding RightSegmentBrush}" />
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{DynamicResource Text.RightZone}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel Margin="52,9,0,0" Orientation="Horizontal">
                            <Button Content="{DynamicResource Text.Swap}"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Click="SwapSegmentColor_Click" />
                            <Button Margin="7,0,0,0"
                                    Content="{DynamicResource Text.Apply}"
                                    IsEnabled="{Binding CanApplySegmentRgb}"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Click="ApplySegmentColor_Click" />
                            <Button Margin="7,0,0,0"
                                    Content="{DynamicResource Text.RestoreWholeColor}"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Click="RestoreWholeColor_Click" />
                        </StackPanel>
                        <TextBlock Margin="52,7,0,0"
                                   Text="{Binding SegmentRgbStatus}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{DynamicResource WarningBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="6"
                    Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Text.LocalPresets}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <Grid Margin="0,11,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PresetComboBox"
                                  MinHeight="30"
                                  Padding="7,4"
                                  ItemsSource="{Binding Presets}"
                                  SelectedItem="{Binding SelectedPreset}"
                                  DisplayMemberPath="Name" />
                        <TextBlock Margin="10,0,30,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   IsHitTestVisible="False"
                                   Text="{DynamicResource Text.NoPresets}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPreset}"
                                                     Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Content="{DynamicResource Text.Apply}"
                                IsEnabled="{Binding CanControl}"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="ApplyPresetButton_Click" />
                        <Button Grid.Column="2"
                                Margin="6,0,0,0"
                                Content="{DynamicResource Text.Save}"
                                IsEnabled="{Binding IsDeviceOnline}"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="SavePresetButton_Click" />
                        <Button Grid.Column="3"
                                Margin="6,0,0,0"
                                Content="{DynamicResource Text.Delete}"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="DeletePresetButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Margin="0,0,12,0"
                               MaxWidth="280"
                               Text="{Binding HotkeyStatus}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource WarningBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HotkeyStatus}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,4,12,0"
                               MaxWidth="280"
                               Text="{Binding AutomationStatus}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AutomationStatus}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,4,12,0"
                               MaxWidth="280"
                               Text="{Binding DiagnosticStatus}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource WarningBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DiagnosticStatus}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{DynamicResource Text.Device}"
                            Margin="0,0,8,0"
                            Style="{StaticResource QuietButtonStyle}"
                            ToolTip="{DynamicResource Text.OpenDeviceDetails}"
                            Click="DeviceDetailsButton_Click" />
                    <Button Content="{DynamicResource Text.Settings}"
                            Style="{StaticResource QuietButtonStyle}"
                            ToolTip="{DynamicResource Text.OpenSettings}"
                            Click="SettingsButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
