<Window x:Class="LibraTray.App.CustomColorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Text.CustomColorTitle}"
        Width="360"
        Height="220"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Text.CustomColorPrompt}"
                   FontSize="16"
                   FontWeight="SemiBold" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="42" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="HexTextBox"
                     Padding="9,7"
                     MaxLength="7"
                     TextChanged="HexTextBox_TextChanged" />
            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="5">
                <Ellipse x:Name="PreviewEllipse" />
            </Border>
        </Grid>
        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="3"
                   Margin="0,8,0,0"
                   Text="{DynamicResource Text.CustomColorExample}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="76" Margin="0,0,8,0"
                    Content="{DynamicResource Text.Cancel}" IsCancel="True"
                    Style="{StaticResource QuietButtonStyle}" />
            <Button Width="76" Content="{DynamicResource Text.Apply}" IsDefault="True"
                    Style="{StaticResource QuietButtonStyle}"
                    Click="ApplyButton_Click" />
        </StackPanel>
    </Grid>
</Window>
