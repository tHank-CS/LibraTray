<Window x:Class="LibraTray.App.PresetNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Text.SavePresetTitle}"
        Icon="/Assets/libratray.ico"
        Width="360"
        Height="190"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Text.PresetName}"
                   FontSize="16"
                   FontWeight="SemiBold" />
        <TextBox x:Name="NameTextBox"
                 Grid.Row="2"
                 MaxLength="64"
                 Padding="9,7"
                 Text="{DynamicResource Text.DefaultPresetName}" />
        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="3"
                   Margin="0,7,0,0"
                   Foreground="{DynamicResource ErrorBrush}"
                   Visibility="Collapsed" />
        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="76" Margin="0,0,8,0"
                    Content="{DynamicResource Text.Cancel}" IsCancel="True"
                    Style="{StaticResource QuietButtonStyle}" />
            <Button Width="76" Content="{DynamicResource Text.Save}" IsDefault="True"
                    Style="{StaticResource QuietButtonStyle}"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
