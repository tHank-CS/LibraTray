<Window x:Class="LibraTray.App.DeviceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LibraTray · 设备详情"
        Width="620"
        Height="660"
        MinWidth="560"
        MinHeight="560"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,16,9" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,9" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="DeviceNameTextBlock"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Text="Yeelight Libra Pro" />
                <TextBlock x:Name="ConnectionStatusTextBlock"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="未连接" />
            </StackPanel>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="刷新状态"
                    Style="{StaticResource QuietButtonStyle}"
                    Click="RefreshButton_Click" />
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="设备详情">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,14,4,4">
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="产品身份" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="126" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="友好产品名" />
                                    <TextBlock x:Name="FriendlyNameTextBlock" Grid.Column="1"
                                               Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource DetailLabelStyle}" Text="硬件型号" />
                                    <TextBlock x:Name="HardwareModelTextBlock" Grid.Row="1" Grid.Column="1"
                                               Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource DetailLabelStyle}" Text="内部型号" />
                                    <TextBlock x:Name="InternalModelTextBlock" Grid.Row="2" Grid.Column="1"
                                               Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="3" Style="{StaticResource DetailLabelStyle}" Text="设备上报名" />
                                    <TextBlock x:Name="ReportedNameTextBlock" Grid.Row="3" Grid.Column="1"
                                               Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="4" Style="{StaticResource DetailLabelStyle}" Text="设备 ID" />
                                    <TextBlock x:Name="DeviceIdTextBlock" Grid.Row="4" Grid.Column="1"
                                               Style="{StaticResource DetailValueStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="本地连接" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="126" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="固件版本" />
                                    <TextBlock x:Name="FirmwareTextBlock" Grid.Column="1"
                                               Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource DetailLabelStyle}" Text="控制端点" />
                                    <TextBlock x:Name="EndpointTextBlock" Grid.Row="1" Grid.Column="1"
                                               Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource DetailLabelStyle}" Text="连接时间" />
                                    <TextBlock x:Name="ConnectedAtTextBlock" Grid.Row="2" Grid.Column="1"
                                               Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="3" Style="{StaticResource DetailLabelStyle}" Text="声明能力" />
                                    <TextBlock x:Name="CapabilitiesTextBlock" Grid.Row="3" Grid.Column="1"
                                               Style="{StaticResource DetailValueStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="最近确认状态" />
                                <TextBlock x:Name="StateSummaryTextBlock"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="LastUpdatedTextBlock"
                                           Margin="0,7,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="诊断">
                <Grid Margin="4,14,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Padding="14"
                            CornerRadius="8"
                            Background="{StaticResource AccentSoftBrush}">
                        <TextBlock Text="以下摘要默认脱敏，不包含设备 ID、局域网端点、设备上报名或用户别名。分享前仍应自行检查。"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    <TextBox x:Name="DiagnosticTextBox"
                             Grid.Row="2"
                             Padding="12"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas" />
                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <Button Content="复制脱敏摘要"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="CopyDiagnosticButton_Click" />
                        <Button Margin="8,0,0,0"
                                Content="打开探针日志目录"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="OpenLogsButton_Click" />
                        <TextBlock x:Name="DiagnosticActionTextBlock"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="4"
                Width="82"
                HorizontalAlignment="Right"
                Content="关闭"
                IsCancel="True"
                Style="{StaticResource QuietButtonStyle}"
                Click="CloseButton_Click" />
    </Grid>
</Window>
