<Window x:Class="LibraTray.App.DeviceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource Text.DeviceDetailsTitle}"
        Icon="/Assets/libratray.ico"
        Width="560"
        Height="597"
        MinWidth="560"
        MinHeight="560"
        WindowStyle="None"
        Background="{DynamicResource WindowBrush}"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,16,9" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,9" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Background="Transparent"
              MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="DeviceNameTextBlock"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Text="Yeelight Libra Pro" />
                <TextBlock x:Name="ConnectionStatusTextBlock"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{DynamicResource Text.NotConnected}" />
            </StackPanel>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Content="{DynamicResource Text.RefreshState}"
                    Style="{StaticResource QuietButtonStyle}"
                    Click="RefreshButton_Click" />
            <Button Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource TitleBarCloseButtonStyle}"
                    ToolTip="{DynamicResource Text.Close}"
                    Click="CloseButton_Click">
                <TextBlock Margin="0,-2,0,0" FontSize="20" Text="×" />
            </Button>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="{DynamicResource Text.DeviceDetails}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,14,4,4">
                        <Border Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{DynamicResource Text.ProductIdentity}" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="126" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="{DynamicResource Text.FriendlyProductName}" />
                                    <TextBlock x:Name="FriendlyNameTextBlock" Grid.Column="1"
                                               Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource DetailLabelStyle}" Text="{DynamicResource Text.HardwareModel}" />
                                    <TextBlock x:Name="HardwareModelTextBlock" Grid.Row="1" Grid.Column="1"
                                               Style="{StaticResource DetailValueStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{DynamicResource Text.LocalConnection}" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="126" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource DetailLabelStyle}" Text="{DynamicResource Text.FirmwareVersion}" />
                                    <TextBlock x:Name="FirmwareTextBlock" Grid.Column="1"
                                               Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource DetailLabelStyle}" Text="{DynamicResource Text.ConnectionTime}" />
                                    <TextBlock x:Name="ConnectedAtTextBlock" Grid.Row="1" Grid.Column="1"
                                               Style="{StaticResource DetailValueStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{DynamicResource Text.LastConfirmedState}" />
                                <TextBlock x:Name="StateSummaryTextBlock"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="LastUpdatedTextBlock"
                                           Margin="0,7,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Style="{StaticResource SectionCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{DynamicResource Text.BackgroundPost}" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="{DynamicResource Text.BackgroundPostHint}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{DynamicResource WarningBrush}" />
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <Button x:Name="BackgroundPostButton"
                                            Content="{DynamicResource Text.BackgroundPost}"
                                            IsEnabled="{Binding CanControl}"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Click="BackgroundPostButton_Click" />
                                    <TextBlock x:Name="BackgroundPostStatusTextBlock"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Text.Diagnostics}">
                <Grid Margin="4,14,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Padding="14"
                            CornerRadius="8"
                            Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="{DynamicResource Text.DiagnosticsPrivacy}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                    <TextBox x:Name="DiagnosticTextBox"
                             Grid.Row="2"
                             Padding="12"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas" />
                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <Button Content="{DynamicResource Text.CopyRedactedSummary}"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="CopyDiagnosticButton_Click" />
                        <Button Margin="8,0,0,0"
                                Content="{DynamicResource Text.OpenProbeLogs}"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="OpenLogsButton_Click" />
                        <TextBlock x:Name="DiagnosticActionTextBlock"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="4"
                Width="82"
                HorizontalAlignment="Right"
                Content="{DynamicResource Text.Close}"
                IsCancel="True"
                Style="{StaticResource QuietButtonStyle}"
                Click="CloseButton_Click" />
    </Grid>
</Window>
