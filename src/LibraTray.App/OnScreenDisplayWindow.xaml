<Window x:Class="LibraTray.App.OnScreenDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LibraTray OSD"
        Width="320"
        Height="112"
        Left="-10000"
        Top="-10000"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Margin="4"
            Padding="16,13"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="5" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="DeviceNameTextBlock"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MetricTextBlock"
                           VerticalAlignment="Bottom"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="ValueTextBlock"
                           Grid.Column="1"
                           Margin="16,0,0,0"
                           VerticalAlignment="Bottom"
                           FontSize="24"
                           FontWeight="SemiBold" />
            </Grid>
            <ProgressBar x:Name="ValueProgressBar"
                         Grid.Row="4"
                         Minimum="0"
                         Maximum="100"
                         Background="{DynamicResource DividerBrush}"
                         Foreground="{DynamicResource AccentBrush}" />
        </Grid>
    </Border>
</Window>
